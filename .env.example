# ─────────────────────────────────────────────────────────────
# Visa Slot Monitor — DEPLOYMENT env (used by docker-compose)
# Copy to .env and fill in.
#
# NOTE: Per-USER app config (Telegram / Twilio / checkvisaslots /
# Ollama) is NOT set here — each user enters their own values in the
# web Setup wizard, and they are stored per-account in Postgres.
# ─────────────────────────────────────────────────────────────

# Port the web UI is published on (local/dev only; prod uses Caddy on 80/443)
PORT=8000

# Public URL the app is reached at (must match the Google OAuth redirect)
# Local:  http://localhost:8000
# Prod:   https://slots.yourdomain.com
PUBLIC_BASE_URL=http://localhost:8000

# Production domain for Caddy auto-HTTPS (only used by docker-compose.prod.yml)
DOMAIN=

# Restrict sign-in to approved emails (comma-separated). REQUIRED for a private
# deployment — leave empty only for local testing (open to any Google account).
ALLOWED_EMAILS=

# Postgres password (compose provisions the DB automatically)
POSTGRES_PASSWORD=change-me

# Secret used to sign session cookies. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Set to 1 when served over HTTPS (production) so cookies are marked Secure
COOKIE_SECURE=0

# ── Google OAuth ──
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local testing without Google: set to 1 to enable a "Dev login" button
ALLOW_DEV_LOGIN=0

# ── SMTP (welcome email / transactional) ── optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

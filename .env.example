# Telegram API credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=


# Telegram channels to monitor (username or invite link, comma-separated)
# Example: usvisaslots,f1visaindia
TELEGRAM_CHANNELS=

# Twilio credentials
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio WhatsApp sandbox number (keep the 'whatsapp:' prefix)
TWILIO_WHATSAPP_FROM=whatsapp:

# Your WhatsApp number to receive alerts (with country code)
ALERT_TO=whatsapp:

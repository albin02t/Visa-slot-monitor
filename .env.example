# ─────────────────────────────────────────────────────────────
# Visa Slot Monitor — DEPLOYMENT env (used by docker-compose)
# Copy to .env and fill in.
#
# NOTE: Per-USER app config (Telegram / Twilio / checkvisaslots /
# Ollama) is NOT set here — each user enters their own values in the
# web Setup wizard, and they are stored per-account in Postgres.
# ─────────────────────────────────────────────────────────────

# Port the web UI is published on
PORT=8000

# Public URL the app is reached at (must match the Google OAuth redirect)
PUBLIC_BASE_URL=http://localhost:8000

# Postgres password (compose provisions the DB automatically)
POSTGRES_PASSWORD=change-me

# Secret used to sign session cookies — generate a long random string
JWT_SECRET=change-me-to-a-long-random-string

# Set to 1 when served over HTTPS so cookies are marked Secure
COOKIE_SECURE=0

# ── Google OAuth ──
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <PUBLIC_BASE_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local testing without Google: set to 1 to enable a "Dev login" button
ALLOW_DEV_LOGIN=0

# ── SMTP (welcome email / transactional) ── optional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
